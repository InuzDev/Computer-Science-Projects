# ---------- Windows (paths like C:/...) ----------
If:
   PathMatch: '[A-Za-z]:/.*\.c'
CompileFlags:
   Add:
      - -std=gnu17
      - -target
      - x86_64-w64-windows-gnu
      - -IC:/Users/carlos/scoop/apps/gcc/current/include
      - -IC:/Users/carlos/scoop/apps/gcc/current/x86_64-w64-mingw32/include
---
If:
   PathMatch: '[A-Za-z]:/.*\.(cpp|cc|cxx)'
CompileFlags:
   Add:
      - -std=c++17
      - -target
      - x86_64-w64-windows-gnu
      - -IC:/Users/carlos/scoop/apps/gcc/current/include
      - -IC:/Users/carlos/scoop/apps/gcc/current/x86_64-w64-mingw32/include
---
If:
   PathMatch: '[A-Za-z]:/.*/Fundamental-of-computational-systems/.*\.c'
CompileFlags:
   Remove:
      - x86_64-w64-windows-gnu
      - -IC:/Users/carlos/scoop/apps/gcc/current/x86_64-w64-mingw32/include
   Add:
      - -std=gnu17
      - -target
      - x86_64-pc-linux-gnu
      - -isystem/usr/include
      - -isystem/usr/include/x86_64-linux-gnu
---
# ---------- macOS (paths like /Users/...) ----------
If:
   PathMatch: '/.*\.c'
CompileFlags:
   Add:
      - -std=gnu17
      # Optional fallback, only if clangd cannot find stdio.h or stdlib.h:
      # - -isysroot
      # - /Library/Developer/CommandLineTools/SDKs/MacOSX.sdk
---
If:
   PathMatch: '/.*\.(cpp|cc|cxx)'
CompileFlags:
   Add:
      - -std=c++17
